# Единственный внешний порт. API доступен через frontend: /api, /docs, /health.
HHPULSE_WEB_PORT=3000

# demo — полностью рабочая демонстрация интерфейса; api — реальные jobs/progress endpoints.
HHPULSE_FRONTEND_DATA_MODE=demo

HHPULSE_LOG_LEVEL=INFO
HHPULSE_QUARANTINE_RETENTION_HOURS=24
HHPULSE_SOURCE_TIMEOUT_SECONDS=30
HHPULSE_RETRY_INITIAL_SECONDS=5
HHPULSE_RETRY_MAX_SECONDS=900
HHPULSE_PREFLIGHT_SUCCESSES=3
HHPULSE_SCHEDULER_POLL_SECONDS=30

# Автоматически открыть интерфейс после успешного ./deploy.sh.
HHPULSE_OPEN_BROWSER=1
HHPULSE_DEPLOY_TIMEOUT_SECONDS=180

# Обычно менять не нужно. Теги вынесены сюда для воспроизводимого обновления.
HHPULSE_PYTHON_IMAGE=python:3.12-slim-bookworm
HHPULSE_NODE_IMAGE=node:24-alpine
HHPULSE_NGINX_IMAGE=nginxinc/nginx-unprivileged:1.27-alpine
